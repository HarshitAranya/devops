pipeline {
    agent { label 'prod-agent' }  // Ensures execution on a production node
    options {
        timeout(time: 30, unit: 'MINUTES')  // Prevents long-running jobs
    }
    environment {
        DEPLOY_ENV = 'production'
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/user/repo.git'
            }
        }
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
        stage('Approval') {
            steps {
                script {
                    def userInput = input message: 'Proceed with deployment?', 
                                         ok: 'Yes', 
                                         parameters: []
                    echo "Deployment approved, proceeding..."
                }
            }
        }
        stage('Deploy') {
            steps {
                sh './deploy.sh'
            }
        }
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/user/repo.git'
            }
        }
        stage('Deploy') {
            steps {
                sh 'deploy.sh'
            }
        }
        stage('Rollback') {
            when {
                failure()
            }
            steps {
                sh 'git reset --hard HEAD~1' // Rollback to the previous commit
                sh 'deploy.sh' // Redeploy with the last stable version
            }
        }
        stage('Deploy') {
            steps {
                sh "docker run -d --name my-app -p 80:80 ${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }
        stage('Verify') {
            steps {
                script {
                    def status = sh(script: "curl -s -o /dev/null -w '%{http_code}' http://localhost", returnStdout: true).trim()
                    if (status != '200') {
                        error("Deployment failed, triggering rollback...")
                    }
                }
            }
        }
        stage('Rollback') {
            when {
                failure()
            }
            steps {
                sh "docker stop my-app && docker rm my-app"
                sh "docker run -d --name my-app -p 80:80 ${IMAGE_NAME}:previous-version" // Use the last stable image tag
            }
        }

        stage('Deploy') {
            steps {
                sh 'kubectl apply -f deployment.yaml'
            }
        }
        stage('Verify Deployment') {
            steps {
                script {
                    def status = sh(script: "kubectl rollout status deployment my-app", returnStatus: true)
                    if (status != 0) {
                        error("Deployment failed, triggering rollback...")
                    }
                }
            }
        }
        stage('Rollback') {
            when {
                failure()
            }
            steps {
                sh 'kubectl rollout undo deployment my-app'
            }
        }

    }
    post {
        success {
            echo 'Deployment Successful!'
        }
        failure {
            echo 'Deployment Failed!'
        }
    }
}
